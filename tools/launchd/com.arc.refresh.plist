<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  凱旋門賞の週末の反映（tools/refresh_arc.mjs）。10分おき。PMU のロンシャン全レース（出馬表・結果・馬場）と JRA 特設を取り直し、
  arc.html / longchamp.html を作り直して commit。ARC_DAY の3日後からは何もしない（終わったら unload してよい）。
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.arc.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/tools/refresh_arc.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>ARC_WAIT</key><string>1200</string>
  </dict>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>__REPO__/data/arc/refresh.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/arc/refresh.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
