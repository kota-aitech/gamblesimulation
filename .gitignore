# 取得した生ページのキャッシュ（再取得すれば作れる。数百MB になる）
data/cache/
# 生データと中間ファイル（index.json / races.*.json から再生成できる）
data/nankan/leading.raw.json
data/nankan/cards.jsonl
# launchd が書くログと実行状態（マシンごとの一時ファイル）
data/nankan/*.log
data/nankan/.refresh-stamp
# ボート：公式ダウンロードデータの展開結果（od2 のキャッシュから作り直せる。各220MB超）
data/boat/results.jsonl
data/boat/programs.jsonl
data/boat/*.log
data/jra/results.jsonl
data/jra/cards.jsonl
data/jra/*.log
data/boat/.live.lock
data/boat/.od2-stamp
data/boat/.refresh-stamp
data/banei/results.jsonl
data/banei/cards.jsonl
data/banei/*.log
# クラウド側（odds-cloud ブランチ）の作業用。手元では使い捨て
data/odds_cloud/
# 競輪：レース詳細を1レース1行にしたもの（Kドリームスのキャッシュから作り直せる。1年で数百MB）
data/keirin/races.jsonl
data/keirin/*.log
data/keirin/.refresh-stamp
data/keirin/.fetch.lock
data/keirin/.pause
data/keirin/.backfill
data/keirin/asof.json
